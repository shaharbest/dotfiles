{
  "includeCoAuthoredBy": false,
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pdf-hint.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/Projects/menashe-forge/docs/claude/hooks/theme-css-guard.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "theme": "custom:omarchy",
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(virsh:*--connect qemu:///system*)",
      "Bash(rm:*state/disk.qcow2*)"
    ]
  }
}
