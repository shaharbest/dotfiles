# vim: ft=dosini
#
# Minimal styleset: picks no colors at all, so every element just renders in
# the terminal's own default fg/bg (which Omarchy already themes). It adds
# exactly two things:
#
#   1. Reverse fg/bg on whatever's selected, so the cursor is visible without
#      picking a highlight color.
#   2. Two attribute-only named styles (bold/dim, no color) that aerc.conf's
#      column-name/column-date templates reference, for contrast between the
#      sender/date columns and the rest of the message-list row.
#
# To disable: switch aerc.conf's [ui] styleset-name back to "catppuccin" and
# remove the column-name/column-date override lines in aerc.conf (search for
# "column contrast override").

*.selected.reverse=toggle

[user]
col_sender.bold=true
col_date.dim=true
